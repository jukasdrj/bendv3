{
  "name": "@jukasdrj/bookstrack-api-client",
  "version": "1.1.0",
  "description": "TypeScript SDK for BooksTrack API with SSE/WebSocket streaming support - Auto-generated from OpenAPI specification",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "openapi-typescript ../../docs/openapi.yaml -o src/schema.ts",
    "build": "tsc",
    "prepublishOnly": "npm run generate && npm run build"
  },
  "keywords": [
    "bookstrack",
    "api",
    "sdk",
    "typescript",
    "openapi"
  ],
  "author": "BooksTrack Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jukasdrj/bendv3.git",
    "directory": "packages/api-client"
  },
  "files": [
    "dist",
    "README.md",
    "STREAMING_GUIDE.md",
    "CHANGELOG.md"
  ],
  "devDependencies": {
    "openapi-typescript": "^7.4.3",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "openapi-fetch": "^0.13.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
