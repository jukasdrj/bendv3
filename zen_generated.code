  544│ function deduplicateBooks(books) {
  545│   const seen = new Map();
  546│ 
  547│   for (const book of books) {
  548│     // Use ISBN as primary key, fallback to title+author
  549│     const key = book.isbn || `${book.title}::${book.author}`;
  550│ 
  551│     if (!seen.has(key)) {
  552│       seen.set(key, book);
  553│     } else {
  554│       // Keep book with higher confidence
  555│       const existing = seen.get(key);
  556│       if ((book.confidence || 0) > (existing.confidence || 0)) {
  557│         seen.set(key, book);
  558│       }
  558│     }
  559│   }
  560│ 
  561│   return Array.from(seen.values());
  562│ }
