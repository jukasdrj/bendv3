{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "//": "====================================================================================",
  "//": "BooksTrack Backend - STAGING Environment Configuration",
  "//": "====================================================================================",
  "//": "",
  "//": "Staging environment for safe testing before production deployments.",
  "//": "Inherits all settings from wrangler.jsonc and overrides only staging-specific values.",
  "//": "",
  "//": "Usage:",
  "//": "  Deploy: npx wrangler deploy --config wrangler.staging.jsonc",
  "//": "  Logs:   npx wrangler tail --config wrangler.staging.jsonc",
  "//": "",
  "//": "====================================================================================",
  "name": "api-worker-staging",
  "main": "src/index.js",
  "compatibility_date": "2025-11-14",
  "workers_dev": false,
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal",
    "cache_no_cache_enabled"
  ],
  "routes": [
    {
      "pattern": "api-staging.oooefam.net/*",
      "zone_name": "oooefam.net"
    }
  ],
  "vars": {
    "//": "Staging-specific overrides",
    "LOG_LEVEL": "debug",
    "ENABLE_PERFORMANCE_LOGGING": "true",
    "ENABLE_CACHE_ANALYTICS": "true",
    "STRUCTURED_LOGGING": "true",

    "//": "All other vars inherited from wrangler.jsonc defaults",
    "ENABLE_HONO_ROUTER": "true",
    "WORKFLOW_ROLLOUT_PERCENT": "100",
    "ENABLE_WORKFLOW_IMPORT": "true",
    "CACHE_HOT_TTL": "7200",
    "CACHE_COLD_TTL": "1209600",
    "MAX_RESULTS_DEFAULT": "40",
    "RATE_LIMIT_MS": "50",
    "CONCURRENCY_LIMIT": "10",
    "AGGRESSIVE_CACHING": "true",
    "ACCESS_TRACKING_SAMPLE_RATE": "0.01",
    "CACHE_ALERT_HIT_RATE_THRESHOLD_CRITICAL": "0.65",
    "CACHE_ALERT_HIT_RATE_THRESHOLD_WARNING": "0.70",
    "CACHE_ALERT_HOT_CACHE_THRESHOLD_CRITICAL": "0.80",
    "CACHE_ALERT_HOT_CACHE_THRESHOLD_WARNING": "0.85",
    "CACHE_ALERT_DROP_THRESHOLD_CRITICAL": "0.15",
    "CACHE_ALERT_DROP_THRESHOLD_WARNING": "0.10",
    "ALERT_FROM_EMAIL": "alerts@bookstrack.com",
    "ALERT_TO_EMAIL": "ops@bookstrack.com",
    "ENABLE_PROVIDER_METRICS": "true",
    "ENABLE_RATE_LIMIT_TRACKING": "true",
    "OPENLIBRARY_BASE_URL": "https://openlibrary.org",
    "USER_AGENT": "BooksTracker/1.0 (nerd@ooheynerds.com) ExternalAPIsWorker/1.0.0",
    "AI_PROVIDER": "gemini",
    "MAX_IMAGE_SIZE_MB": "10",
    "REQUEST_TIMEOUT_MS": "50000",
    "CONFIDENCE_THRESHOLD": "0.7",
    "MAX_SCAN_FILE_SIZE": "10485760",
    "ENABLE_UNIFIED_ENVELOPE": "true",
    "ENABLE_REFACTORED_DOS": "true",
    "ENABLE_HIBERNATION_WEBSOCKET": "true",
    "ENABLE_D1_WRITES": "true",
    "D1_READ_PERCENTAGE": "100",
    "D1_MIGRATION_BATCH_SIZE": "1000",
    "VALIDATE_DUAL_WRITES": "false"
  },
  "//": "Durable Objects (shared with production)",
  "durable_objects": {
    "bindings": [
      {
        "name": "PROGRESS_WEBSOCKET_DO",
        "class_name": "ProgressWebSocketDO",
        "script_name": "api-worker-staging"
      },
      {
        "name": "RATE_LIMITER_DO",
        "class_name": "RateLimiterDO",
        "script_name": "api-worker-staging"
      },
      {
        "name": "PROGRESS_WEBSOCKET_DO_HIBERNATION",
        "class_name": "ProgressWebSocketDO_Hibernation",
        "script_name": "api-worker-staging"
      },
      {
        "name": "WEBSOCKET_CONNECTION_DO",
        "class_name": "WebSocketConnectionDO",
        "script_name": "api-worker-staging"
      },
      {
        "name": "JOB_STATE_MANAGER_DO",
        "class_name": "JobStateManagerDO",
        "script_name": "api-worker-staging"
      },
      {
        "name": "CACHE_METRICS_DO",
        "class_name": "CacheMetricsDO",
        "script_name": "api-worker-staging"
      },
      {
        "name": "LATENCY_TEST_DO",
        "class_name": "LatencyTestDO",
        "script_name": "api-worker-staging"
      }
    ]
  },
  "//": "Workflows (shared bindings)",
  "workflows": [
    {
      "binding": "BOOK_IMPORT_WORKFLOW",
      "name": "book-import-workflow",
      "class_name": "BookImportWorkflow"
    }
  ],
  "//": "KV Namespaces - STAGING specific",
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "staging_kv_cache_id_placeholder",
      "//": "Create staging KV namespace: wrangler kv namespace create CACHE --preview false"
    },
    {
      "binding": "RECOMMENDATIONS_CACHE",
      "id": "staging_recommendations_cache_id_placeholder",
      "//": "Create staging KV namespace: wrangler kv namespace create RECOMMENDATIONS_CACHE --preview false"
    }
  ],
  "//": "Queues - STAGING specific",
  "queues": {
    "producers": [
      {
        "binding": "AUTHOR_WARMING_QUEUE",
        "queue": "author-warming-queue-staging",
        "//": "Create staging queue: wrangler queues create author-warming-queue-staging"
      },
      {
        "binding": "ENRICHMENT_QUEUE",
        "queue": "enrichment-queue-staging",
        "//": "Create staging queue: wrangler queues create enrichment-queue-staging"
      }
    ],
    "consumers": [
      {
        "queue": "author-warming-queue-staging",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "author-warming-dlq-staging"
      },
      {
        "queue": "enrichment-queue-staging",
        "max_batch_size": 100,
        "max_batch_timeout": 60,
        "max_retries": 3,
        "dead_letter_queue": "enrichment-dlq-staging"
      }
    ]
  },
  "//": "D1 Database - STAGING specific",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookstrack-library-staging",
      "database_id": "staging_d1_id_placeholder",
      "//": "Create staging D1: wrangler d1 create bookstrack-library-staging"
    }
  ],
  "//": "Vectorize - STAGING specific",
  "vectorize": [
    {
      "binding": "BOOK_VECTORS",
      "index_name": "book-embeddings-staging",
      "//": "Create staging vectorize: wrangler vectorize create book-embeddings-staging --dimensions=768 --metric=cosine"
    }
  ],
  "//": "R2 Buckets - STAGING specific",
  "r2_buckets": [
    {
      "binding": "API_CACHE_COLD",
      "bucket_name": "personal-library-data-staging",
      "//": "Create staging R2: wrangler r2 bucket create personal-library-data-staging"
    },
    {
      "binding": "LIBRARY_DATA",
      "bucket_name": "personal-library-data-staging"
    },
    {
      "binding": "BOOKSHELF_IMAGES",
      "bucket_name": "bookshelf-images-staging",
      "//": "Create staging R2: wrangler r2 bucket create bookshelf-images-staging"
    },
    {
      "binding": "BOOK_COVERS",
      "bucket_name": "bookstrack-covers-staging",
      "//": "Create staging R2: wrangler r2 bucket create bookstrack-covers-staging"
    }
  ],
  "//": "Analytics Engine - shared with production",
  "analytics_engine_datasets": [
    {
      "binding": "PERFORMANCE_ANALYTICS",
      "dataset": "books_api_performance"
    },
    {
      "binding": "CACHE_ANALYTICS",
      "dataset": "books_api_cache_metrics"
    },
    {
      "binding": "ANALYTICS_ENGINE",
      "dataset": "books_api_provider_performance"
    },
    {
      "binding": "AI_ANALYTICS",
      "dataset": "bookshelf_ai_performance"
    },
    {
      "binding": "SAMPLING_ANALYTICS",
      "dataset": "books_api_sampling_metrics"
    }
  ],
  "//": "AI Binding - shared with production",
  "ai": {
    "binding": "AI"
  }
}
