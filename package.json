{
  "name": "api-worker",
  "version": "3.4.3",
  "description": "Unified BooksTrack API Worker",
  "main": "src/index.ts",
  "type": "module",
  "workspaces": [
    "packages/schemas",
    "packages/api-client"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "test": "npm run test:workers && npm run test:node",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "test:node": "vitest run --config vitest.node.config.ts",
    "test:watch": "vitest --config vitest.node.config.ts",
    "test:ui": "vitest --ui --config vitest.node.config.ts",
    "test:coverage": "vitest --coverage --config vitest.node.config.ts",
    "test:e2e": "RUN_E2E_TESTS=true vitest run --config vitest.node.config.ts",
    "test:safe": "npm run test:smoke && TEST_SAFE_MODE=true npm run test:node",
    "test:smoke": "vitest run --config vitest.workers.config.ts",
    "test:unit": "vitest run --config vitest.node.config.ts --exclude='tests/integration/**' --exclude='tests/e2e/**'",
    "test:alexandria": "vitest run --config vitest.node.config.ts tests/integration/alexandria-contract.test.ts",
    "validate": "npm run lint:check && npm run test:smoke",
    "lint:check": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "detect-breaking-changes": "tsx scripts/detect-breaking-changes.ts",
    "check-alexandria-version": "tsx scripts/check-alexandria-version.ts",
    "update-wrangler": "npm install wrangler@latest",
    "generate:openapi": "bash scripts/generate-openapi-baseline.sh",
    "docs:v3": "echo 'V3 API Docs: Start dev server (npm run dev) and visit http://localhost:8787/v3/docs'"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.10",
    "@cloudflare/vitest-pool-workers": "^0.10.15",
    "@cloudflare/workers-types": "^4.20251212.0",
    "@stoplight/spectral-cli": "^6.15.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "msw": "^2.12.4",
    "openapi-diff": "^0.24.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wrangler": "^4.59.2"
  },
  "dependencies": {
    "@bookstrack/schemas": "file:./packages/schemas",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.1.5",
    "alexandria-worker": "^2.8.0",
    "hono": "^4.10.8",
    "uuid": "^13.0.0",
    "zod": "^4.1.13"
  }
}
