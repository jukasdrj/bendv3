{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "//": "====================================================================================",
  "//": "BooksTrack Backend - Cloudflare Workers Configuration",
  "//": "====================================================================================",
  "//": "",
  "//": "Remote Bindings (Wrangler v4.37+)",
  "//": "You can now access production resources during local development by setting",
  "//": "`remote: true` on individual bindings (KV, R2, D1, etc.).",
  "//": "",
  "//": "Benefits:",
  "//": "  - Test local code changes against real production data",
  "//": "  - Share resources across development team",
  "//": "  - Reproduce bugs tied to real data",
  "//": "  - No need to deploy for every test iteration",
  "//": "",
  "//": "Usage:",
  "//": "  1. Set `remote: true` on any binding below",
  "//": "  2. Run `npx wrangler dev` as normal",
  "//": "  3. Your local code will connect to production resources",
  "//": "",
  "//": "Documentation: .claude/WRANGLER_COMMAND_STANDARDS.md",
  "//": "====================================================================================",
  "name": "api-worker",
  "main": "src/index.js",
  "compatibility_date": "2025-11-14",
  "workers_dev": true,
  "compatibility_flags": [
    "nodejs_compat",
    "enable_request_signal",
    "cache_no_cache_enabled"
  ],
  "routes": [
    {
      "pattern": "api.oooefam.net/*",
      "zone_name": "oooefam.net"
    }
  ],
  "vars": {
    "//": "========================================================================",
    "//": "Cloudflare Workflows Feature Flags (Issue #71 - Launch Blocker)",
    "//": "WORKFLOW_ROLLOUT_PERCENT: 0-100 for gradual rollout",
    "//": "ENABLE_WORKFLOW_IMPORT: 'true'/'false' to force enable/disable",
    "//": "========================================================================",
    "WORKFLOW_ROLLOUT_PERCENT": "100",
    "ENABLE_WORKFLOW_IMPORT": "true",
    "//": "Cache configuration",
    "CACHE_HOT_TTL": "7200",
    "CACHE_COLD_TTL": "1209600",
    "MAX_RESULTS_DEFAULT": "40",
    "RATE_LIMIT_MS": "50",
    "CONCURRENCY_LIMIT": "10",
    "AGGRESSIVE_CACHING": "true",
    "//": "========================================================================",
    "//": "Access Tracking Sampling (Issue #112 - KV Write Optimization)",
    "//": "Sample rate: 0.01 = 1% sampling (99% write reduction)",
    "//": "10,000 req/hour → 100 access tracking writes instead of 10,000",
    "//": "========================================================================",
    "ACCESS_TRACKING_SAMPLE_RATE": "0.01",
    "//": "========================================================================",
    "//": "Cache Monitoring & Alerting Configuration",
    "//": "Thresholds for cache hit rate alerts (0.0 - 1.0 scale)",
    "//": "========================================================================",
    "CACHE_ALERT_HIT_RATE_THRESHOLD_CRITICAL": "0.65",
    "CACHE_ALERT_HIT_RATE_THRESHOLD_WARNING": "0.70",
    "CACHE_ALERT_HOT_CACHE_THRESHOLD_CRITICAL": "0.80",
    "CACHE_ALERT_HOT_CACHE_THRESHOLD_WARNING": "0.85",
    "CACHE_ALERT_DROP_THRESHOLD_CRITICAL": "0.15",
    "CACHE_ALERT_DROP_THRESHOLD_WARNING": "0.10",
    "ALERT_FROM_EMAIL": "alerts@bookstrack.com",
    "ALERT_TO_EMAIL": "ops@bookstrack.com",
    "//": "Logging configuration",
    "//": "LOG_LEVEL: 'error' (critical only), 'info' (default), 'debug' (verbose)",
    "LOG_LEVEL": "info",
    "ENABLE_PERFORMANCE_LOGGING": "true",
    "ENABLE_CACHE_ANALYTICS": "true",
    "ENABLE_PROVIDER_METRICS": "true",
    "ENABLE_RATE_LIMIT_TRACKING": "true",
    "STRUCTURED_LOGGING": "true",
    "//": "External API configuration",
    "OPENLIBRARY_BASE_URL": "https://openlibrary.org",
    "USER_AGENT": "BooksTracker/1.0 (nerd@ooheynerds.com) ExternalAPIsWorker/1.0.0",
    "//": "AI configuration",
    "AI_PROVIDER": "gemini",
    "MAX_IMAGE_SIZE_MB": "10",
    "REQUEST_TIMEOUT_MS": "50000",
    "CONFIDENCE_THRESHOLD": "0.7",
    "MAX_SCAN_FILE_SIZE": "10485760",
    "//": "WebSocket Hibernation API Migration (RE-ENABLED - Nov 24, 2025)",
    "//": "R2 migration complete - large payloads now stored in R2 instead of DO storage",
    "ENABLE_HIBERNATION_WEBSOCKET": "true",
    "//": "========================================================================",
    "//": "Sprint 2: KV to D1 Migration (Phase-based Rollout)",
    "//": "Day 8: D1-PRIMARY MODE (100% of reads from D1, KV fallback only)",
    "//": "Writes: BOTH KV + D1 (dual-write - KV becomes cache layer)",
    "//": "Reads: 100% D1-first → KV fallback",
    "//": "========================================================================",
    "ENABLE_D1_WRITES": "true",
    "D1_READ_PERCENTAGE": "100",
    "D1_MIGRATION_BATCH_SIZE": "1000",
    "//": "Day 6: Optional dual-write validation (set to 'true' for dev/testing)",
    "VALIDATE_DUAL_WRITES": "false",
    "//": "========================================================================",
    "//": "Alexandria Hono RPC Migration (Sprint 1 - ACTIVATED Dec 3, 2025)",
    "//": "Enables sub-millisecond RPC calls to Alexandria via Service Binding",
    "//": "Package: alexandria-worker@2.0.0",
    "//": "Expected: 75x latency improvement (150ms → <2ms P95)",
    "//": "Status: ACTIVE - Service binding + feature flag enabled",
    "//": "========================================================================",
    "ENABLE_ALEXANDRIA_RPC": "true"
  },
  "//": "========================================================================",
  "//": "Service Bindings - Hono RPC (Sprint 1: Alexandria Migration - ACTIVE)",
  "//": "ALEXANDRIA service binding enables sub-millisecond internal RPC calls",
  "//": "with full type safety via Hono RPC client",
  "//": "Status: ACTIVE (Alexandria deployed Dec 3, 2025)",
  "//": "========================================================================",
  "services": [
    {
      "binding": "ALEXANDRIA",
      "service": "alexandria",
      "entrypoint": "default"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      "id": "b9cade63b6db48fd80c109a013f38fdb"
    },
    {
      "//": "Sprint 3: Weekly recommendations cache",
      "binding": "RECOMMENDATIONS_CACHE",
      "id": "be0ca7077bab4942b57c02d547f1c968"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BOOKSHELF_IMAGES",
      "bucket_name": "bookshelf-images"
    },
    {
      "//": "bendv3 CDN cache for user-facing cover serving (separate from Alexandria's canonical bookstrack-covers-processed)",
      "binding": "BOOK_COVERS",
      "bucket_name": "bookstrack-covers"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bookstrack-library",
      "database_id": "cc19e622-9d0d-45f6-991c-1ab1933f257c"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "//": "========================================================================",
  "//": "Vectorize Index (Sprint 3 - Semantic Search, Issues #25, #26)",
  "//": "Create with: npx wrangler vectorize create book-embeddings --dimensions 1024 --metric cosine",
  "//": "========================================================================",
  "vectorize": [
    {
      "binding": "BOOK_VECTORS",
      "index_name": "book-embeddings"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER_DO",
        "class_name": "RateLimiterDO"
      },
      {
        "name": "WEBSOCKET_CONNECTION_DO",
        "class_name": "WebSocketConnectionDO"
      },
      {
        "name": "JOB_STATE_MANAGER_DO",
        "class_name": "JobStateManagerDO"
      },
      {
        "name": "CACHE_METRICS_DO",
        "class_name": "CacheMetricsDO"
      },
      {
        "name": "LATENCY_TEST_DO",
        "class_name": "LatencyTestDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v2",
      "new_classes": ["RateLimiterDO"]
    },
    {
      "tag": "v3",
      "new_classes": ["WebSocketConnectionDO", "JobStateManagerDO"]
    },
    {
      "tag": "v4",
      "new_classes": ["CacheMetricsDO"]
    },
    {
      "tag": "v6",
      "new_classes": ["LatencyTestDO"]
    },
    {
      "tag": "v7",
      "new_classes": []
    }
  ],
  "analytics_engine_datasets": [
    {
      "binding": "PERFORMANCE_ANALYTICS",
      "dataset": "books_api_performance"
    },
    {
      "binding": "CACHE_ANALYTICS",
      "dataset": "books_api_cache_metrics"
    },
    {
      "binding": "ANALYTICS_ENGINE",
      "dataset": "books_api_provider_performance"
    },
    {
      "binding": "AI_ANALYTICS",
      "dataset": "bookshelf_ai_performance"
    },
    {
      "binding": "SAMPLING_ANALYTICS",
      "dataset": "books_api_sampling_metrics"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1.0,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1.0,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1.0,
      "persist": true
    }
  },
  "limits": {
    "cpu_ms": 300000
  },
  "placement": {
    "mode": "smart"
  },
  "queues": {
    "producers": [
      {
        "binding": "AUTHOR_WARMING_QUEUE",
        "queue": "author-warming-queue"
      },
      {
        "//": "Sprint 3: Async book enrichment with vectorization - Routes to Alexandria",
        "binding": "ENRICHMENT_QUEUE",
        "queue": "alexandria-enrichment-queue"
      },
      {
        "//": "Cover & Queue Architecture: Send cover requests to Alexandria",
        "binding": "ALEXANDRIA_COVER_QUEUE",
        "queue": "alexandria-cover-queue"
      }
    ],
    "consumers": [
      {
        "queue": "author-warming-queue",
        "max_batch_size": 10,
        "max_batch_timeout": 30,
        "max_retries": 3,
        "dead_letter_queue": "author-warming-dlq",
        "max_concurrency": 5
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "0 3 * * *",
      "0 0 * * SUN",
      "0 */6 * * *",
      "0 * * * *"
    ]
  },
  "//": "Cron schedule: */15 * * * * = every 15min (alerts), 0 3 * * * = daily 3am (cover harvest), 0 0 * * SUN = Sunday midnight (weekly recommendations), 0 */6 * * * = every 6 hours (static popular books cache warm-up), 0 * * * * = hourly (analytics-driven cache warm-up)",
  "//": "========================================================================",
  "//": "Cloudflare Workflows (Issue #71 - Launch Blocker)",
  "//": "Book import pipeline with automatic retries and state persistence",
  "//": "========================================================================",
  "workflows": [
    {
      "name": "book-import-workflow",
      "binding": "BOOK_IMPORT_WORKFLOW",
      "class_name": "BookImportWorkflow"
    }
  ],
  "//": "========================================================================",
  "//": "Secrets Store Bindings (Account-level secrets)",
  "//": "Using Cloudflare Secrets Store instead of per-Worker secrets",
  "//": "Store ID: b0562ac16fde468c8af12717a6c88400 (default_secrets_store)",
  "//": "========================================================================",
  "//": "Sprint 2 Thin Client: GOOGLE_BOOKS_API_KEY and ISBNDB_API_KEY removed",
  "//": "BooksTrack no longer calls external APIs directly (Alexandria handles them)",
  "secrets_store_secrets": [
    {
      "binding": "GEMINI_API_KEY",
      "store_id": "b0562ac16fde468c8af12717a6c88400",
      "secret_name": "google_gemini_oooebooks"
    }
  ],
  "//": "========================================================================",
  "//": "Alexandria Authentication (Worker Secrets - not Secrets Store)",
  "//": "ALEXANDRIA_CLIENT_ID and ALEXANDRIA_CLIENT_SECRET are Worker secrets",
  "//": "ALEXANDRIA_WEBHOOK_SECRET is shared secret for webhook authentication",
  "//": "Added via: npx wrangler secret put ALEXANDRIA_WEBHOOK_SECRET",
  "//": "========================================================================"
}
